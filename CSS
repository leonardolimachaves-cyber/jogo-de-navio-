* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  user-select: none;
}

body {
  overflow: hidden;
  background: #071929;
  font-family: 'Segoe UI', Tahoma, sans-serif;
  color: #fff;
}

canvas {
  display: block;
}

#hud {
  position: absolute;
  top: 16px;
  left: 16px;
  background: rgba(8, 22, 38, 0.82);
  border: 1px solid rgba(100, 180, 255, 0.35);
  border-radius: 10px;
  padding: 14px 18px;
  min-width: 250px;
  backdrop-filter: blur(4px);
}

#hud h2 {
  font-size: 16px;
  color: #5cc8ff;
  margin-bottom: 8px;
  letter-spacing: 0.5px;
}

.stat {
  font-size: 14px;
  margin: 5px 0;
  display: flex;
  justify-content: space-between;
}

.bar-bg {
  width: 100%;
  height: 10px;
  background: #1c2e40;
  border-radius: 5px;
  overflow: hidden;
  margin-top: 4px;
}

#hp-bar {
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, #2ecc71, #27ae60);
  transition: width 0.2s;
}

#boss-hud {
  position: absolute;
  top: 16px;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(50, 10, 15, 0.88);
  border: 2px solid #ff4757;
  border-radius: 10px;
  padding: 10px 22px;
  min-width: 340px;
  text-align: center;
  display: none;
}

#boss-hud h3 {
  color: #ff6b81;
  font-size: 15px;
  margin-bottom: 6px;
  text-transform: uppercase;
}

#boss-hp-bar {
  width: 100%;
  height: 12px;
  background: linear-gradient(90deg, #ff4757, #ff6b81);
  transition: width 0.2s;
}

#banner {
  position: absolute;
  top: 22%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 28px;
  font-weight: bold;
  text-align: center;
  text-shadow: 0 3px 12px rgba(0, 0, 0, 0.9);
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.4s;
}

#controls {
  position: absolute;
  bottom: 16px;
  left: 16px;
  background: rgba(8, 22, 38, 0.75);
  padding: 10px 14px;
  border-radius: 8px;
  font-size: 13px;
  color: #cde6ff;
  line-height: 1.5;
}

#overlay {
  position: absolute;
  inset: 0;
  background: rgba(5, 15, 28, 0.88);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  z-index: 10;
}

#overlay h1 {
  font-size: 38px;
  color: #5cc8ff;
  margin-bottom: 10px;
}

#overlay p {
  font-size: 16px;
  color: #b8d8f8;
  max-width: 480px;
  margin-bottom: 24px;
}

button {
  background: #1e90ff;
  color: #fff;
  border: none;
  padding: 14px 32px;
  font-size: 18px;
  font-weight: bold;
  border-radius: 8px;
  cursor: pointer;
  box-shadow: 0 4px 15px rgba(30, 144, 255, 0.4);
}

button:hover {
  background: #379eff;
}