// --- CONSTRUTOR DE NAVIOS 3D ---
function buildWarship(colorHull, scale = 1, extraTurrets = 0) {
  const ship = new THREE.Group();

  const hullGeo = new THREE.BoxGeometry(4.2 * scale, 2.2 * scale, 18 * scale);
  const hullMat = new THREE.MeshStandardMaterial({ color: colorHull, metalness: 0.5, roughness: 0.5 });
  const hull = new THREE.Mesh(hullGeo, hullMat);
  hull.position.y = 0.8 * scale;
  ship.add(hull);

  const bowGeo = new THREE.ConeGeometry(3.0 * scale, 5 * scale, 4);
  bowGeo.rotateX(-Math.PI / 2);
  bowGeo.rotateY(Math.PI / 4);
  const bow = new THREE.Mesh(bowGeo, hullMat);
  bow.position.set(0, 0.8 * scale, -11.2 * scale);
  ship.add(bow);

  const bridgeGeo = new THREE.BoxGeometry(2.6 * scale, 3.2 * scale, 4.5 * scale);
  const bridgeMat = new THREE.MeshStandardMaterial({ color: 0x7f8c8d, roughness: 0.6 });
  const bridge = new THREE.Mesh(bridgeGeo, bridgeMat);
  bridge.position.set(0, 3.2 * scale, 0.5 * scale);
  ship.add(bridge);

  const funnelGeo = new THREE.CylinderGeometry(0.7 * scale, 0.9 * scale, 2.8 * scale, 8);
  const funnelMat = new THREE.MeshStandardMaterial({ color: 0x2c3e50 });
  const funnel = new THREE.Mesh(funnelGeo, funnelMat);
  funnel.position.set(0, 3.2 * scale, 3.5 * scale);
  ship.add(funnel);

  const turrets = [];
  const turretPositions = [-5.5, 6.5];
  if (extraTurrets >= 1) turretPositions.push(-2.5);
  if (extraTurrets >= 2) turretPositions.push(3.8);

  turretPositions.forEach((zPos) => {
    const tGroup = new THREE.Group();
    tGroup.position.set(0, 2.1 * scale, zPos * scale);

    const base = new THREE.Mesh(
      new THREE.BoxGeometry(1.8 * scale, 0.9 * scale, 2.0 * scale),
      new THREE.MeshStandardMaterial({ color: 0x576574 })
    );
    tGroup.add(base);

    const barrel = new THREE.Mesh(
      new THREE.CylinderGeometry(0.22 * scale, 0.25 * scale, 3.4 * scale, 8),
      new THREE.MeshStandardMaterial({ color: 0x222f3e })
    );
    barrel.rotation.x = Math.PI / 2;
    barrel.position.set(0, 0.1 * scale, -2.0 * scale);
    tGroup.add(barrel);

    ship.add(tGroup);
    turrets.push(tGroup);
  });

  ship.userData.turrets = turrets;
  return ship;
}

// --- JOGADOR ---
let playerMesh = buildWarship(0x34495e, 1, 0);
scene.add(playerMesh);

const player = {
  level: 1,
  kills: 0,
  nextLevelKills: 1,
  hp: 1000,
  maxHp: 1000,
  damage: 150,
  speed: 0,
  maxSpeed: 0.42,
  reloadTime: 1100,
  lastShot: 0
};

// --- INIMIGOS, PROJÉTEIS E PARTÍCULAS ---
const enemies = [];
const projectiles = [];
const particles = [];
let bossActive = false;
let bossEntity = null;

function spawnEnemy(isBoss = false) {
  const scale = isBoss ? 2.4 : 1.0;
  const color = isBoss ? 0x6b141a : 0x5c3a3a;
  const extra = isBoss ? 2 : 0;
  const mesh = buildWarship(color, scale, extra);

  const angle = Math.random() * Math.PI * 2;
  const dist = isBoss ? 190 : 120 + Math.random() * 110;
  mesh.position.set(
    playerMesh.position.x + Math.cos(angle) * dist,
    0,
    playerMesh.position.z + Math.sin(angle) * dist
  );
  scene.add(mesh);

  const enemyData = {
    mesh,
    isBoss,
    hp: isBoss ? 3200 : 350 + player.level * 80,
    maxHp: isBoss ? 3200 : 350 + player.level * 80,
    damage: isBoss ? 140 : 45 + player.level * 10,
    speed: isBoss ? 0.16 : 0.22,
    lastShot: performance.now() + Math.random() * 1500,
    reload: isBoss ? 1800 : 2800
  };

  enemies.push(enemyData);
  if (isBoss) {
    bossActive = true;
    bossEntity = enemyData;
    document.getElementById('boss-hud').style.display = 'block';
    playBossSiren();
    showBanner("⚠️ CHEFÃO ENCOURAÇADO DETECTADO! ⚠️", "#ff4757");
  }
}

function createSplashOrExplosion(pos, color, count = 14, scale = 0.8) {
  for (let i = 0; i < count; i++) {
    const p = new THREE.Mesh(
      new THREE.BoxGeometry(scale, scale, scale),
      new THREE.MeshBasicMaterial({ color })
    );
    p.position.copy(pos);
    scene.add(p);
    particles.push({
      mesh: p,
      vel: new THREE.Vector3(
        (Math.random() - 0.5) * 1.2,
        Math.random() * 1.4 + 0.4,
        (Math.random() - 0.5) * 1.2
      ),
      life: 1.0
    });
  }
}

function fireCannons(sourceMesh, targetPos, isPlayer, damage, isBoss = false) {
  playCannonSound(isBoss);
  const turrets = sourceMesh.userData.turrets;

  turrets.forEach((t) => {
    const worldPos = new THREE.Vector3();
    t.getWorldPosition(worldPos);

    const dir = new THREE.Vector3().subVectors(targetPos, worldPos);
    const dist = dir.length();
    dir.normalize();

    const shell = new THREE.Mesh(
      new THREE.SphereGeometry(isBoss ? 0.65 : 0.38, 8, 8),
      new THREE.MeshBasicMaterial({ color: isPlayer ? 0xffdd59 : 0xff5e57 })
    );
    shell.position.copy(worldPos);
    shell.position.y += 0.6;
    scene.add(shell);

    const speed = 2.6;
    const flightTicks = Math.max(15, dist / speed);

    projectiles.push({
      mesh: shell,
      vel: new THREE.Vector3(dir.x * speed, 0.28, dir.z * speed),
      gravity: (0.28 * 2) / flightTicks,
      isPlayer,
      damage
    });
  });
}

function showBanner(text, color = "#5cc8ff") {
  const banner = document.getElementById('banner');
  banner.textContent = text;
  banner.style.color = color;
  banner.style.opacity = 1;
  setTimeout(() => { banner.style.opacity = 0; }, 2600);
}

function evolvePlayer() {
  player.level++;
  player.nextLevelKills += 2;
  player.maxHp += 350;
  player.hp = player.maxHp;
  player.damage = Math.round(player.damage * 1.25);
  player.maxSpeed += 0.05;
  player.reloadTime = Math.max(450, player.reloadTime * 0.88);

  const oldPos = playerMesh.position.clone();
  const oldRot = playerMesh.rotation.clone();
  scene.remove(playerMesh);

  const extraTurrets = player.level >= 3 ? 2 : 1;
  const newScale = 1 + Math.min(0.45, (player.level - 1) * 0.12);
  playerMesh = buildWarship(0x2c3e50, newScale, extraTurrets);
  playerMesh.position.copy(oldPos);
  playerMesh.rotation.copy(oldRot);
  scene.add(playerMesh);

  playLevelUpSound();
  createSplashOrExplosion(playerMesh.position, 0x5cc8ff, 25, 1.1);
  showBanner(`EVOLUÇÃO! NAVIO NÍVEL ${player.level} (+CANHÕES & BLINDAGEM)`, "#2ecc71");
}

function updateHUD() {
  document.getElementById('lvl').textContent = player.level;
  document.getElementById('hp-text').textContent = `${Math.max(0, Math.round(player.hp))} / ${player.maxHp}`;
  document.getElementById('hp-bar').style.width = `${Math.max(0, (player.hp / player.maxHp) * 100)}%`;
  document.getElementById('kills').textContent = player.kills;
  document.getElementById('dmg').textContent = player.damage;
  document.getElementById('spd').textContent = `${Math.round(Math.abs(player.speed) * 75)} nós`;

  if (bossActive && bossEntity) {
    const pct = Math.max(0, (bossEntity.hp / bossEntity.maxHp) * 100);
    document.getElementById('boss-hp-bar').style.width = `${pct}%`;
  }
}

// --- CONTROLES DE TECLADO E MOUSE ---
const keys = {};
let camYaw = 0;
let camPitch = 0.35;
let isDragging = false;
let gameRunning = false;

window.addEventListener('keydown', (e) => { keys[e.code] = true; });
window.addEventListener('keyup', (e) => { keys[e.code] = false; });

window.addEventListener('mousedown', (e) => {
  if (!gameRunning) return;
  isDragging = true;
  if (e.button === 0) shootPlayer();
});
window.addEventListener('mouseup', () => { isDragging = false; });
window.addEventListener('mousemove', (e) => {
  if (isDragging) {
    camYaw -= e.movementX * 0.005;
    camPitch = Math.max(0.12, Math.min(1.1, camPitch + e.movementY * 0.005));
  }
});

function getAimTarget() {
  const forward = new THREE.Vector3(
    -Math.sin(camYaw),
    0,
    -Math.cos(camYaw)
  );
  return playerMesh.position.clone().addScaledVector(forward, 130);
}

function shootPlayer() {
  const now = performance.now();
  if (now - player.lastShot < player.reloadTime) return;
  player.lastShot = now;
  fireCannons(playerMesh, getAimTarget(), true, player.damage, false);
}

// --- LOOP PRINCIPAL ---
let clock = new THREE.Clock();

function animate() {
  requestAnimationFrame(animate);
  const time = clock.getElapsedTime();

  const posAttr = ocean.geometry.attributes.position;
  for (let i = 0; i < posAttr.count; i++) {
    const x = posAttr.getX(i);
    const z = posAttr.getZ(i);
    const wave = Math.sin(x * 0.04 + time * 1.6) * 0.45 + Math.cos(z * 0.04 + time * 1.3) * 0.45;
    posAttr.setY(i, wave);
  }
  posAttr.needsUpdate = true;

  if (!gameRunning) {
    renderer.render(scene, camera);
    return;
  }

  if (keys['KeyW'] || keys['ArrowUp']) {
    player.speed = Math.min(player.maxSpeed, player.speed + 0.006);
  } else if (keys['KeyS'] || keys['ArrowDown']) {
    player.speed = Math.max(-player.maxSpeed * 0.5, player.speed - 0.006);
  } else {
    player.speed *= 0.985;
  }

  const turnFactor = Math.min(1, Math.abs(player.speed) * 3.5);
  if (keys['KeyA'] || keys['ArrowLeft']) playerMesh.rotation.y += 0.015 * turnFactor;
  if (keys['KeyD'] || keys['ArrowRight']) playerMesh.rotation.y -= 0.015 * turnFactor;
  if (keys['Space']) shootPlayer();

  playerMesh.translateZ(-player.speed);
  playerMesh.position.y = Math.sin(time * 2.2) * 0.18;
  playerMesh.rotation.z = Math.sin(time * 1.7) * 0.03;

  if (engineOsc) {
    engineOsc.frequency.value = 36 + Math.abs(player.speed) * 65;
  }

  const aimPos = getAimTarget();
  playerMesh.userData.turrets.forEach((t) => t.lookAt(aimPos.x, t.getWorldPosition(new THREE.Vector3()).y, aimPos.z));

  const normalEnemies = enemies.filter(e => !e.isBoss).length;
  if (normalEnemies < 3) spawnEnemy(false);

  const now = performance.now();
  for (let i = enemies.length - 1; i >= 0; i--) {
    const e = enemies[i];
    const toPlayer = new THREE.Vector3().subVectors(playerMesh.position, e.mesh.position);
    const dist = toPlayer.length();

    const targetAngle = Math.atan2(-toPlayer.x, -toPlayer.z);
    e.mesh.rotation.y += (targetAngle - e.mesh.rotation.y) * 0.015;

    if (dist > (e.isBoss ? 85 : 65)) {
      e.mesh.translateZ(-e.speed);
    }
    e.mesh.position.y = Math.sin(time * 2 + i) * 0.2;

    if (dist < 220 && now - e.lastShot > e.reload) {
      e.lastShot = now;
      fireCannons(e.mesh, playerMesh.position, false, e.damage, e.isBoss);
    }
  }

  for (let i = projectiles.length - 1; i >= 0; i--) {
    const p = projectiles[i];
    p.mesh.position.add(p.vel);
    p.vel.y -= p.gravity;

    let hit = false;

    if (p.isPlayer) {
      for (let j = enemies.length - 1; j >= 0; j--) {
        const e = enemies[j];
        const hitRadius = e.isBoss ? 14 : 6.5;
        if (p.mesh.position.distanceTo(e.mesh.position) < hitRadius) {
          hit = true;
          e.hp -= p.damage;
          playExplosionSound(false);
          createSplashOrExplosion(p.mesh.position, 0xff9f43, 12, 0.9);

          if (e.hp <= 0) {
            createSplashOrExplosion(e.mesh.position, 0xff4757, 35, 1.5);
            scene.remove(e.mesh);
            enemies.splice(j, 1);

            player.kills++;
            if (e.isBoss) {
              bossActive = false;
              bossEntity = null;
              document.getElementById('boss-hud').style.display = 'none';
              showBanner("🏆 VITÓRIA! VOCÊ DERROTOU O SUPER CHEFÃO! 🏆", "#ffdd59");
              evolvePlayer();
            } else {
              if (player.kills >= player.nextLevelKills) evolvePlayer();
              if (player.kills === 4 && !bossActive) spawnEnemy(true);
            }
          }
          break;
        }
      }
    } else {
      if (p.mesh.position.distanceTo(playerMesh.position) < 6.5) {
        hit = true;
        player.hp -= p.damage;
        playExplosionSound(false);
        createSplashOrExplosion(p.mesh.position, 0xff6b6b, 10, 0.8);

        if (player.hp <= 0) {
          gameRunning = false;
          document.getElementById('overlay').style.display = 'flex';
          document.querySelector('#overlay h1').textContent = "SEU NAVIO AFUNDOU!";
          document.querySelector('#overlay p').textContent = `Você alcançou o Nível ${player.level} e destruiu ${player.kills} navios inimigos.`;
          document.getElementById('start-btn').textContent = "JOGAR NOVAMENTE";
        }
      }
    }

    if (!hit && p.mesh.position.y <= 0) {
      hit = true;
      playExplosionSound(true);
      createSplashOrExplosion(p.mesh.position, 0xdff9fb, 10, 0.7);
    }

    if (hit) {
      scene.remove(p.mesh);
      projectiles.splice(i, 1);
    }
  }

  for (let i = particles.length - 1; i >= 0; i--) {
    const pt = particles[i];
    pt.mesh.position.add(pt.vel);
    pt.vel.y -= 0.05;
    pt.life -= 0.03;
    pt.mesh.scale.setScalar(Math.max(0.01, pt.life));
    if (pt.life <= 0) {
      scene.remove(pt.mesh);
      particles.splice(i, 1);
    }
  }

  const camDist = 34 + player.level * 2;
  const camX = playerMesh.position.x + Math.sin(camYaw) * Math.cos(camPitch) * camDist;
  const camY = playerMesh.position.y + Math.sin(camPitch) * camDist + 4;
  const camZ = playerMesh.position.z + Math.cos(camYaw) * Math.cos(camPitch) * camDist;
  camera.position.lerp(new THREE.Vector3(camX, camY, camZ), 0.15);
  camera.lookAt(playerMesh.position.x, playerMesh.position.y + 3, playerMesh.position.z);

  updateHUD();
  renderer.render(scene, camera);
}

document.getElementById('start-btn').addEventListener('click', () => {
  initAudio();
  enemies.forEach(e => scene.remove(e.mesh));
  enemies.length = 0;
  bossActive = false;
  bossEntity = null;
  document.getElementById('boss-hud').style.display = 'none';

  scene.remove(playerMesh);
  playerMesh = buildWarship(0x34495e, 1, 0);
  scene.add(playerMesh);

  Object.assign(player, {
    level: 1, kills: 0, nextLevelKills: 1,
    hp: 1000, maxHp: 1000, damage: 150,
    speed: 0, maxSpeed: 0.42, reloadTime: 1100
  });

  document.getElementById('overlay').style.display = 'none';
  gameRunning = true;
});

window.addEventListener('resize', () => {
  camera.aspect = window.innerWidth / window.innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(window.innerWidth, window.innerHeight);
});

animate();